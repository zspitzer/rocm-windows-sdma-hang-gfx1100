+def _moe_align_block_size_torch(
+    topk_ids: torch.Tensor,
+    block_size: int,
+    num_experts: int,
+) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Pure-torch moe_align_block_size: same buffers/semantics as the triton kernels
+    below, no host syncs. Used on ROCm, where the triton histogram/cumsum/atomic
+    kernels give wrong expert_ids / totals on RDNA3 (gfx1100)."""
+    device = topk_ids.device
+    numel = topk_ids.numel()
+    effective_E = num_experts + 1
+    if numel < effective_E:
+        max_num_tokens_padded = numel * block_size
+    else:
+        max_num_tokens_padded = numel + effective_E * (block_size - 1)
+    max_num_m_blocks = _div_ceil(max_num_tokens_padded, block_size)
+
+    flat = topk_ids.reshape(-1).long()
+    counts = torch.zeros(effective_E, dtype=torch.long, device=device)
+    counts.scatter_add_(0, flat, torch.ones_like(flat))
+    nblk = (counts + block_size - 1) // block_size
+    excl_blk = torch.cumsum(nblk, 0) - nblk
+    num_tokens_post_pad = (nblk.sum() * block_size).to(torch.int32).reshape(1)
+
+    # expert owning block b = largest e with excl_blk[e] <= b (blocks past the total are never read)
+    b = torch.arange(max_num_m_blocks, device=device)
+    expert_ids = (torch.searchsorted(excl_blk, b, right=True) - 1).to(torch.int32)
+
+    order = torch.argsort(flat, stable=True)
+    sorted_e = flat[order]
+    start = torch.cumsum(counts, 0) - counts
+    rank = torch.arange(numel, device=device) - start[sorted_e]
+    pos = excl_blk[sorted_e] * block_size + rank
+    sorted_token_ids = torch.full((max_num_tokens_padded,), numel, dtype=torch.int32, device=device)
+    sorted_token_ids[pos] = order.to(torch.int32)
+    return sorted_token_ids, expert_ids, num_tokens_post_pad
+
