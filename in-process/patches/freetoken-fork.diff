index 0000000..2acd919
--- /dev/null
+++ b/python/freetoken/h2dtrace.py
@@ -0,0 +1,19 @@
+# TEMPORARY spike instrumentation (H2D wedge). Remove with the "H2D-TRACE" lines.
+import os
+import sys
+import time
+
+import torch
+
+ON = os.environ.get("FT_H2D_TRACE") == "1"
+ONLY = [t for t in os.environ.get("FT_H2D_TRACE_ONLY", "").split(",") if t]
+
+
+def T(tag: str) -> None:
+	if not ON:
+		return
+	if ONLY and tag not in ONLY:
+		return
+	print(f"[h2d-trace {time.time():.3f}] before-sync {tag}", file=sys.stderr, flush=True)
+	torch.cuda.synchronize()
+	print(f"[h2d-trace {time.time():.3f}] ok {tag}", file=sys.stderr, flush=True)
diff --git a/python/freetoken/h2dprobe.py b/python/freetoken/h2dprobe.py
new file mode 100644
index 0000000..f53f8f9
--- /dev/null
+++ b/python/freetoken/h2dprobe.py
@@ -0,0 +1,202 @@
+# TEMPORARY spike instrumentation (H2D wedge read-back probe). Remove with the "H2D-PROBE" lines.
+import os
+import sys
+import threading
+import time
+
+import torch
+
+ON = os.environ.get("FT_H2D_PROBE") == "1"
+MARKS_ONLY = os.environ.get("FT_H2D_PROBE_MARKS_ONLY") == "1"
+CONSUMER = os.environ.get("FT_H2D_PROBE_CONSUMER", "indexput")
+# full: mirrors + 3 pinned marks (or marks only). devmark: one Triton mark into a DEVICE tensor before index_put.
+# torchfill: one torch fill_ on an unrelated device tensor before index_put. after: one pinned mark AFTER index_put only.
+MODE = os.environ.get("FT_H2D_PROBE_MODE", "full")
+
+if ON:
+	import triton
+	import triton.language as tl
+
+	@triton.jit
+	def _mark_kernel(dst_addr, slot, value):
+		dst_ptr = tl.cast(dst_addr, tl.pointer_type(tl.int64))
+		tl.store(dst_ptr + slot, value)
+
+	@triton.jit
+	def _mirror_kernel(src_ptr, dst_addr, n, BLOCK: tl.constexpr):
+		pid = tl.program_id(0)
+		offs = pid * BLOCK + tl.arange(0, BLOCK)
+		mask = offs < n
+		dst_ptr = tl.cast(dst_addr, tl.pointer_type(tl.int64))
+		v = tl.load(src_ptr + offs, mask=mask, other=0)
+		tl.store(dst_ptr + offs, v, mask=mask)
+
+	@triton.jit
+	def _scatter_kernel(table_ptr, idx_ptr, off_ptr, val_ptr, row_stride, n, BLOCK: tl.constexpr):
+		pid = tl.program_id(0)
+		offs = pid * BLOCK + tl.arange(0, BLOCK)
+		mask = offs < n
+		row = tl.load(idx_ptr + offs, mask=mask, other=0)
+		col = tl.load(off_ptr + offs, mask=mask, other=0)
+		val = tl.load(val_ptr + offs, mask=mask, other=0)
+		tl.store(table_ptr + row * row_stride + col, val, mask=mask)
+
+
+def _log(msg: str) -> None:
+	print(f"[h2d-probe {time.time():.3f}] {msg}", file=sys.stderr, flush=True)
+
+
+class _Probe:
+	def __init__(self) -> None:
+		from freetoken.kernel.pinned import device_ptr
+
+		self.device_ptr = device_ptr
+		self.lock = threading.Lock()
+		self.seq = 0
+		self.armed_at = 0.0
+		self.n = 0
+		self.cap = 0
+		self.mirror_a = None
+		self.mirror_b = None
+		self.marks = torch.zeros(4, dtype=torch.int64, pin_memory=True)
+		self.marks_dev = device_ptr(self.marks)
+		self.expected_a = None
+		self.expected_b = None
+		self.table_shape = None
+		self.reported = 0.0
+		self.dev_marks = torch.zeros(4, dtype=torch.int64, device="cuda")
+		self.dev_dummy = torch.zeros(4, dtype=torch.int64, device="cuda")
+		_log(f"marks data_ptr=0x{self.marks.data_ptr():x} device_ptr=0x{self.marks_dev:x} dev_marks=0x{self.dev_marks.data_ptr():x} consumer={CONSUMER} marks_only={MARKS_ONLY} mode={MODE}")
+		threading.Thread(target=self._watchdog, name="h2d-probe-watchdog", daemon=True).start()
+
+	def _grow(self, n: int) -> None:
+		if n <= self.cap:
+			return
+		self.cap = max(n, 2 * self.cap, 1024)
+		self.mirror_a = torch.full((self.cap,), -1, dtype=torch.int64, pin_memory=True)
+		self.mirror_b = torch.full((self.cap,), -1, dtype=torch.int64, pin_memory=True)
+		self.mirror_a_dev = self.device_ptr(self.mirror_a)
+		self.mirror_b_dev = self.device_ptr(self.mirror_b)
+		_log(f"mirrors cap={self.cap} a data_ptr=0x{self.mirror_a.data_ptr():x} device_ptr=0x{self.mirror_a_dev:x} b data_ptr=0x{self.mirror_b.data_ptr():x} device_ptr=0x{self.mirror_b_dev:x}")
+
+	def _mark(self, slot: int) -> None:
+		_mark_kernel[(1,)](self.marks_dev, slot, self.seq)
+
+	def before_consumer(self, table_idxs, offsets, table_idx_host, positions_host, page_table) -> None:
+		n = table_idxs.numel()
+		with self.lock:
+			self.seq += 1
+			self.n = n
+			self.expected_a = table_idx_host
+			self.expected_b = positions_host
+			self.table_shape = tuple(page_table.shape)
+			self.marks.zero_()
+			self._grow(n)
+			self.mirror_a[:n].fill_(-1)
+			self.mirror_b[:n].fill_(-1)
+			self.armed_at = time.time()
+			self.reported = 0.0
+		if MODE == "devmark":
+			_mark_kernel[(1,)](self.dev_marks.data_ptr(), 0, self.seq)
+			return
+		if MODE == "torchfill":
+			self.dev_dummy.fill_(self.seq)
+			return
+		if MODE == "after":
+			return
+		assert MODE == "full", MODE
+		self._mark(0)
+		if not MARKS_ONLY:
+			grid = (triton.cdiv(n, 1024),)
+			_mirror_kernel[grid](table_idxs, self.mirror_a_dev, n, BLOCK=1024)
+			_mirror_kernel[grid](offsets, self.mirror_b_dev, n, BLOCK=1024)
+		self._mark(1)
+
+	def consumer(self, page_table, table_idxs, offsets, allocated) -> bool:
+		if CONSUMER == "indexput":
+			return False
+		if CONSUMER == "scatter":
+			page_table.view(-1).scatter_(0, table_idxs * page_table.shape[1] + offsets, allocated)
+			return True
+		if CONSUMER == "triton":
+			n = table_idxs.numel()
+			_scatter_kernel[(triton.cdiv(n, 1024),)](page_table, table_idxs, offsets, allocated, page_table.stride(0), n, BLOCK=1024)
+			return True
+		raise ValueError(f"FT_H2D_PROBE_CONSUMER={CONSUMER!r}")
+
+	def after_consumer(self) -> None:
+		if MODE in ("devmark", "torchfill"):
+			return
+		self._mark(2)
+
+	def request_done(self) -> None:
+		with self.lock:
+			self.marks[3] = self.seq
+			seq, n = self.seq, self.n
+		if MODE != "full":
+			_log(f"seq={seq} done mode={MODE} marks={self.marks[:3].tolist()} dev_marks={self.dev_marks.tolist()} dev_dummy={self.dev_dummy.tolist()} n={n}")
+			return
+		if not MARKS_ONLY:
+			mm_a = int((self.mirror_a[:n] != self.expected_a).sum())
+			mm_b = int((self.mirror_b[:n] != self.expected_b).sum())
+		else:
+			mm_a = mm_b = -1
+		_log(f"seq={seq} done marks={self.marks[:3].tolist()} n={n} mismatches a/b={mm_a}/{mm_b}")
+
+	def _report(self, every: bool) -> None:
+		with self.lock:
+			seq, n = self.seq, self.n
+			ea, eb, shape = self.expected_a, self.expected_b, self.table_shape
+		marks = self.marks.tolist()
+		_log(f"WATCHDOG seq={seq} armed {time.time() - self.armed_at:.0f}s ago, request not done. marks(reached,mirrors,indexput,done)={marks} n={n} page_table.shape={shape}")
+		if MARKS_ONLY or MODE != "full":
+			return
+		for name, seen, exp in (("a/table_idxs", self.mirror_a[:n], ea), ("b/offsets", self.mirror_b[:n], eb)):
+			bad = (seen != exp).nonzero().flatten()
+			_log(f"  {name}: mismatches={bad.numel()} seen min..max={int(seen.min())}..{int(seen.max())} expected min..max={int(exp.min())}..{int(exp.max())}")
+			for i in bad[:8].tolist():
+				_log(f"    [{i}] expected={int(exp[i])} seen={int(seen[i])}")
+		_log(f"  addrs: marks=0x{self.marks_dev:x} a=0x{self.mirror_a_dev:x} b=0x{self.mirror_b_dev:x} (dq <addr> L<n> in cdb)")
+
+	def _watchdog(self) -> None:
+		while True:
+			time.sleep(5)
+			if self.armed_at == 0.0 or int(self.marks[3]) == self.seq:
+				continue
+			age = time.time() - self.armed_at
+			if age < 30:
+				continue
+			if self.reported == 0.0 or time.time() - self.reported >= 60:
+				self.reported = time.time()
+				self._report(True)
+
+
+_probe = None
+
+
+def _get() -> _Probe:
+	global _probe
+	if _probe is None:
+		_probe = _Probe()
+	return _probe
+
+
+def before_consumer(table_idxs, offsets, table_idx_host, positions_host, page_table) -> None:
+	if ON:
+		_get().before_consumer(table_idxs, offsets, table_idx_host, positions_host, page_table)
+
+
+def consumer(page_table, table_idxs, offsets, allocated) -> bool:
+	if not ON:
+		return False
+	return _get().consumer(page_table, table_idxs, offsets, allocated)
+
+
+def after_consumer() -> None:
+	if ON:
+		_get().after_consumer()
+
+
+def request_done() -> None:
+	if ON and _probe is not None:
+		_probe.request_done()
